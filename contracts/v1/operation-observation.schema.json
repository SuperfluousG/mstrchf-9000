{
  "$comment": "Generated from mstrchf-contracts; run cargo run --locked -p mstrchf-contracts --bin generate-contracts",
  "$defs": {
    "CalendarEventId": {
      "pattern": "^ce_(?!0{32}$)[0-9a-f]{32}$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EvidenceId": {
      "pattern": "^ev_(?!0{32}$)[0-9a-f]{32}$",
      "type": "string"
    },
    "FinancialCommitment": {
      "enum": [
        "none",
        "unknown"
      ],
      "type": "string"
    },
    "Generation": {
      "description": "Canonical positive decimal u64, maximum 18446744073709551615",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "GrantToken": {
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$",
      "type": "string"
    },
    "Instant": {
      "description": "Exact UTC timestamp with whole seconds",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "JobId": {
      "pattern": "^jb_(?!0{32}$)[0-9a-f]{32}$",
      "type": "string"
    },
    "Nullable_Digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "Nullable_Instant": {
      "anyOf": [
        {
          "$ref": "#/$defs/Instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "Nullable_Text": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "OperationEvidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "additionalProperties": false,
              "properties": {
                "basket_digest": {
                  "$ref": "#/$defs/Digest"
                },
                "evidence_id": {
                  "$ref": "#/$defs/EvidenceId"
                },
                "live_quantity": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "observed_product_ref": {
                  "$ref": "#/$defs/ProductRef"
                }
              },
              "required": [
                "live_quantity",
                "observed_product_ref",
                "basket_digest",
                "evidence_id"
              ],
              "type": "object"
            },
            "kind": {
              "const": "basket",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "$ref": "#/$defs/EvidenceId"
                },
                "logical_event_id": {
                  "$ref": "#/$defs/CalendarEventId"
                },
                "observed_payload_digest": {
                  "$ref": "#/$defs/Nullable_Digest"
                },
                "provider_event_ref": {
                  "$ref": "#/$defs/Nullable_Text"
                }
              },
              "required": [
                "provider_event_ref",
                "logical_event_id",
                "observed_payload_digest",
                "evidence_id"
              ],
              "type": "object"
            },
            "kind": {
              "const": "calendar",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "$ref": "#/$defs/EvidenceId"
                },
                "financial_commitment": {
                  "$ref": "#/$defs/FinancialCommitment"
                },
                "hold_expires_at": {
                  "$ref": "#/$defs/Nullable_Instant"
                },
                "slot_ref": {
                  "$ref": "#/$defs/Text"
                }
              },
              "required": [
                "slot_ref",
                "hold_expires_at",
                "financial_commitment",
                "evidence_id"
              ],
              "type": "object"
            },
            "kind": {
              "const": "slot",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "OperationId": {
      "pattern": "^op_(?!0{32}$)[0-9a-f]{32}$",
      "type": "string"
    },
    "OperationOutcome": {
      "enum": [
        "observed_success",
        "observed_failure",
        "uncertain"
      ],
      "type": "string"
    },
    "ProductRef": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "$ref": "#/$defs/Text"
        },
        "retailer": {
          "$ref": "#/$defs/Retailer"
        },
        "variant_id": {
          "$ref": "#/$defs/Nullable_Text"
        }
      },
      "required": [
        "retailer",
        "product_id",
        "variant_id"
      ],
      "type": "object"
    },
    "Provider": {
      "enum": [
        "codex_local",
        "claude_cowork"
      ],
      "type": "string"
    },
    "Retailer": {
      "enum": [
        "tesco"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "Text": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "native_task_ref": {
          "$ref": "#/$defs/Text"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "provider_build": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "provider",
        "provider_build",
        "native_task_ref",
        "job_id",
        "generation"
      ],
      "type": "object"
    }
  },
  "$id": "urn:mstrchf:contracts:v1:operation-observation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "$ref": "#/$defs/OperationEvidence"
    },
    "grant_token": {
      "$ref": "#/$defs/GrantToken"
    },
    "observed_at": {
      "$ref": "#/$defs/Instant"
    },
    "operation_id": {
      "$ref": "#/$defs/OperationId"
    },
    "outcome": {
      "$ref": "#/$defs/OperationOutcome"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "worker": {
      "$ref": "#/$defs/WorkerIdentity"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "worker",
    "grant_token",
    "observed_at",
    "outcome",
    "evidence"
  ],
  "title": "OperationObservation",
  "type": "object"
}
